{
  "name": "svgbob-gui",
  "version": "0.2.0",
  "description": "Browser-based ASCII diagram editor with live svgbob SVG rendering.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqn2/svgbob-gui.git"
  },
  "bugs": {
    "url": "https://github.com/qqn2/svgbob-gui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "security-check": "node scripts/security-render-check.mjs",
    "check": "npm run typecheck && npm run test && npm run security-check && npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2",
    "js-base64": "^3.7.7",
    "pako": "^1.0.11",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "svgbob-wasm": "^1.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/pako": "^1.0.7",
    "@types/react": "^16.14.56",
    "@types/react-dom": "^16.9.24",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  }
}
