    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/pako": "^1.0.7",
    "@types/react": "^16.14.56",
    "@types/react-dom": "^16.9.24",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vite-node": "^3.2.4",
