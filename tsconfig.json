{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "#asciiflow/*": ["asciiflow-upstream/*"]
    }
  },
  "include": ["asciiflow-upstream/client/**/*"],
  "exclude": [
    "asciiflow-upstream/client/**/*.spec.ts",
    "asciiflow-upstream/client/__tests__/**",
    "asciiflow-upstream/e2e/**"
  ]
}
